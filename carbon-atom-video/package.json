{
  "name": "carbon-atom-video",
  "version": "1.0.0",
  "private": true,
  "description": "فيديو موشن جرافيك تعليمي عن تركيب ذرة الكربون (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render CarbonAtom out/carbon-atom.mp4 --codec=h264",
