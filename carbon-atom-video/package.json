    "test": "node scripts/test-motion.mjs",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource/cairo": "5.3.0",
    "@remotion/cli": "4.0.541",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
